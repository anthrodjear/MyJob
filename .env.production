# =============================================================================
# Production Environment Configuration
# =============================================================================
# Copy this file to .env.production and fill in values before deploying.
#
# Usage:
#   cp .env.production .env.production.local   # Edit this copy
#   docker compose -f docker-compose.yml -f docker-compose.production.yml \\
#     --env-file .env.production up -d
#
# Generate secrets:
#   openssl rand -hex 32           # For 64-char hex strings
#   openssl rand -base64 48        # For base64-encoded strings
#   make hash-password PASSWORD=yourpassword  # For AUTH_PASSWORD_HASH
# =============================================================================

# ---- Database ----
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DATABASE_URL=postgres://myjob:${POSTGRES_PASSWORD}@postgres:5432/myjob?sslmode=require
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ---- Auth ----
# Generate hash: make hash-password PASSWORD=yourpassword
AUTH_PASSWORD_HASH=
# Generate: openssl rand -hex 32
AUTH_JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING_HERE
# Generate: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_ANOTHER_64_CHAR_RANDOM_STRING_HERE

# ---- LLM API Keys ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---- LiveKit (Voice Interview Coach) ----
# Generate: openssl rand -hex 12 (for API key), openssl rand -hex 32 (for secret)
LIVEKIT_API_KEY=CHANGE_ME_LIVEKIT_KEY
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_SECRET
LIVEKIT_WS_URL=ws://livekit:7880
# Production: no --dev flag
LIVEKIT_FLAGS=

# ---- Microsoft Graph (Email Sync) ----
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
EMAIL_FOLDERS=Inbox,Jobs,Applications

# ---- Application ----
APP_ENV=production
QUEUE_CONCURRENCY=10
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=20
OLLAMA_MODEL=nemotron-3-super:cloud
OLLAMA_EMBED_MODEL=granite-embedding:latest

# ---- Nginx / Domain ----
NGINX_SERVER_NAME=your-domain.com
NGINX_SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
NGINX_SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem

# ---- Grafana ----
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ---- Frontend ----
NEXT_PUBLIC_API_URL=/api
